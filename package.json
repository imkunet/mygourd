{
  "name": "mygourd",
  "version": "0.1.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imkunet/mygourd.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./events": {
      "types": "./dist/events/index.d.mts",
      "import": "./dist/events/index.mjs",
      "require": "./dist/events/index.cjs",
      "default": "./dist/events/index.mjs"
    },
    "./interactions": {
      "types": "./dist/interactions/index.d.mts",
      "import": "./dist/interactions/index.mjs",
      "require": "./dist/interactions/index.cjs",
      "default": "./dist/interactions/index.mjs"
    },
    "./routers": {
      "types": "./dist/routers/index.d.mts",
      "import": "./dist/routers/index.mjs",
      "require": "./dist/routers/index.cjs",
      "default": "./dist/routers/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.cjs",
      "default": "./dist/utils/index.mjs"
    },
    "./README.md": "./README.md",
    "./LICENSE.md": "./LICENSE.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack",
    "lint:fix": "vp lint --fix; vp fmt --write",
    "prepare": "vp config"
  },
  "dependencies": {
    "discord.js": "^14.26.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "arkenv": "^0.12.2",
    "arktype": "^2.2.3",
    "consola": "^3.4.2",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.11"
}
